# NeuralVoice Backend — Configuration
# Copy to .env and adjust as needed.

# ---- Server ----
HOST=0.0.0.0
PORT=8000
RELOAD=true                 # set false in production

# ---- Model paths ----
# Defaults to ../model_v1 relative to backend/; override if models live elsewhere.
MODEL_DIR=../model_v1

# ---- Inference ----
# Default model variant used when the ?model_variant param is omitted.
DEFAULT_MODEL=classical_fp32

# ---- LLM Recommendation (Stage 7) ----
# Get a free API key at https://console.groq.com
# If not set, falls back to rule-based recommendations.
GROQ_API_KEY=gsk_your_key_here

# ---- CORS ----
# Comma-separated list of allowed origins. Use * for development only.
ALLOWED_ORIGINS=*
